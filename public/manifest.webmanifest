{
  "name": "خزانة — أرشيفك الذي يفهم",
  "short_name": "خزانة",
  "description": "أرشيف شخصي ذكي يقرأ وثائقك ويرتبها ويمنع تكرارها.",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f2e9",
  "theme_color": "#0f3d39",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "logo.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "./add?shared=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "files", "accept": ["application/pdf", "image/*", ".docx", ".txt", ".zip"] }] }
  }
}
